  - {fileID: 1068682909}
  - {fileID: 670117805}
  - {fileID: 174498838}
  leaderTitle: "\uB208\uB3D9\uC790\uB2D8"
  membersLabel: "\uB208\uAEBC\uD480\uB4E4"
  lineOpening: "\uC0AC\uB791\uD558\uB294 \uB208\uAEBC\uD480 \uC5EC\uB7EC\uBD84, \uC624\uB298\uB3C4 \uBC14\uAE65\uC758 \uC5B4\uC9C0\uB7EC\uC6B4 \uBE5B\uC5D0 \uB9CE\uC774 \uC9C0\uCE58\uC168\uC9C0\uC694?"
  linePhoneBan: "\uC8FC\uBA38\uB2C8 \uC18D \uCC28\uAC00\uC6B4 \uC720\uB9AC \uB208\uC740 \uC6B0\uB9B4 \uC18D\uC785\uB2C8\uB2E4. \uC785\uAD6C\uC5D0 \uB2E4 \uB9E1\uAE30\uC168\uC9C0\uC694?"
  lineBlindfold: "\uC790, \uC774\uC81C \uD558\uC580 \uCC9C\uC73C\uB85C \uB450 \uB208\uC744 \uB36E\uC73C\uC138\uC694. \uC81C \uB208\uC73C\uB85C\uB9CC \uBCF4\uC154\uC57C \uD569\uB2C8\uB2E4."
  chant: "\uB0B4 \uB208\uC744 \uB36E\uACE0 \uB208\uB3D9\uC790\uB2D8\uB9CC \uBCF8\uB2E4"
  lineOpenEyes: "\uB208\uC744 \uB728\uC2ED\uC2DC\uC624. \uC774\uC81C \uC544\uBC84\uC9C0\uC758 \uB208\uC73C\uB85C \uBCF4\uC2ED\uC2DC\uC624."
  lineMiracle: "\uBCF4\uC774\uC2ED\uB2C8\uAE4C? \uC81C\uAC00 \uD5C8\uACF5\uC5D0 \uB5A0\uC624\uB974\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB208\uC744 \uAC10\uC73C\uB2C8 \uBCF4\uC774\uC9C0\uC694?"
  lineWarning: "\uC544\uC9C1 \uAC00\uC871\uC774\uB098 \uD1B5\uC7A5 \uC22B\uC790\uB97C \uBCF4\uB294 \uBD84\uC774 \uC788\uAD70\uC694. \uBC14\uAE65 \uB208\uC740 \uACE7 \uBA49\uB2C8\uB2E4."
  lineClosing: "\uC138\uC0C1\uC774 \uC18C\uB4F1\uB418\uB294 \uB0A0\uAE4C\uC9C0 \uC774 \uADF9\uC7A5 \uBB38\uC744 \uB098\uAC00\uC9C0 \uB9C8\uC138\uC694. \uC81C\uAC00 \uC9C0\uCF1C\uBD05\uB2C8\uB2E4."
  endReason: "\uC9D1\uD68C\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4"
  firstDelay: 10
  loopInterval: 40
  autoLoop: 1
  riseHeight: 0.9
  cycles: 2
